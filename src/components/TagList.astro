---
interface Props {
  tags: string[];
}

const { tags } = Astro.props;
---

{
  tags.length > 0 && (
    <ul class="tag-row">
      {tags.map((tag) => (
        <li>
          <a class="tag" href={`/tags/${encodeURIComponent(tag)}/`}>
            {tag}
          </a>
        </li>
      ))}
    </ul>
  )
}
